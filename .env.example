# ===== system =====
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Montreal
# auto-detected by scripts/env.sh; leave blank to use detection
HOST_IP=
DOMAIN=voxlab.home

# ===== storage =====
# Three roots, split by lifetime. Nothing the stack writes lands in this repo.
# Relative paths (./foo) are resolved to absolute by scripts/env.sh.
#
#   config - app state and databases. Small, precious, back this up.
#            Keep it local: SQLite and Postgres corrupt over NFS/SMB.
#   media  - the bulk library. Point this at the NAS when you have one.
#            Downloads live here too, so imports stay hardlink-fast.
#   cache  - transcodes and ML models. Regenerable, safe to delete anytime.
CONFIG_DIR=/srv/void/config
MEDIA_DIR=/srv/void/media
CACHE_DIR=/srv/void/cache

# ===== VPN (protonvpn via gluetun) =====
# OpenVPN credentials from account.protonvpn.com/account#openvpn
PROTONVPN_OPENVPN_USER=
PROTONVPN_OPENVPN_PASSWORD=
VPN_SERVER_COUNTRIES=Canada
# set to "on" if using a free plan
PROTONVPN_FREE_ONLY=off

# ===== media =====
# auto-detected by scripts/env.sh; leave blank to use detection
RENDER_GID=
